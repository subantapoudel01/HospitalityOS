# AI models — never hardcode elsewhere, only override here (see model_router.py)
AI_CHAT_MODEL=openai/gpt-oss-120b
AI_FAST_MODEL=openai/gpt-oss-20b
AI_EMBED_MODEL=gemini-embedding-001

# Embeddings route separately from chat. 'local' runs a bundled ONNX
# model: no API key, no network, no per-call cost, 384-dim.
# 'gemini' uses AI_EMBED_MODEL above and needs GEMINI_API_KEY — note it
# is 3072-dim, so switching requires a new migration and a full re-embed.
AI_EMBED_PROVIDER=local
AI_EMBED_LOCAL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GROQ_API_KEY=
GEMINI_API_KEY=

# --- chat generation (Slice C) ---
# extractive = answer straight from retrieved passages, no API key,
# no cost, cannot invent facts. gemini/anthropic/openai = hosted.
AI_CHAT_PROVIDER=groq
# Language classification and translation (Slice D) run on FAST_MODEL.
# Nepali support needs this set to gemini; extractive cannot translate.
AI_FAST_PROVIDER=groq
# --- staff accounts ---
# Signs staff session tokens. EMPTY DISABLES LOGIN (503) - there is
# deliberately no built-in default, because a default signing secret in a
# public repo makes every session forgeable.
#
#   make jwt-secret        # prints a fresh value for this line
#   make seed-admin        # creates the first login, prints its password once
#
JWT_SECRET=
# Session lifetime. 720 = one 12-hour shift.
JWT_EXPIRE_MINUTES=720
# MUST be true once the site is served over HTTPS. Leave false locally: a
# Secure cookie is never stored on http://localhost, which looks exactly
# like "signing in does nothing".
COOKIE_SECURE=false
# Leave empty unless the UI and API sit on different subdomains, in which
# case use the shared parent, e.g. .rupakot-resort.com
COOKIE_DOMAIN=

# --- staff dashboard gate (Slice G, superseded) ---
# Shared secret for /api/receptionist/staff/*. NOT authentication: no
# identity, no audit trail, and it grants CROSS-TENANT access because there
# is nothing in it to scope by.
#
# Superseded by JWT_SECRET + real accounts above. Kept working so an
# in-place upgrade does not lock anyone out, and so the eval harness has a
# way in without a password. LEAVE THIS EMPTY IN PRODUCTION - it is a
# second, weaker door into the same rooms.
STAFF_API_TOKEN=

# If the hosted provider fails (rate limit, outage), serve the guest
# from retrieved passages instead of an error. Set to off to 503.
AI_CHAT_FALLBACK=extractive
AI_CHAT_RETRIES=2
# gemini-3.x rejects 0. 128 caps billed thinking tokens; it does NOT make
# latency predictable on the free tier (1.9s to 14.8s observed).
AI_CHAT_THINKING_BUDGET=128
# Leave price rates unset and cost_estimate stays NULL rather than
# being fabricated. Fill in from the provider pricing page.
AI_CHAT_COST_PER_1M_INPUT=
AI_CHAT_COST_PER_1M_OUTPUT=

# WhatsApp Business API
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Database (async driver — backend uses SQLAlchemy's async engine)
DATABASE_URL=postgresql+asyncpg://hospitalityos:devpassword@postgres:5432/hospitalityos
REDIS_URL=redis://redis:6379/0

# Frontend — browser-side calls to the backend (not the docker-network name)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Alternate provider keys — kept ready so model_router.py can A/B test
# without a rewrite (see docs/01-platform/MODEL_SELECTION.md)
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
