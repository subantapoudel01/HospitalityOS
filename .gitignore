# secrets
# Anything .env* EXCEPT the committed *.example templates. Written as a
# wildcard rather than a list because the next variant somebody adds
# (.env.staging, .env.local) must be covered without anyone remembering
# to come back here.
.env
.env.*
!.env.example
!.env.*.example

# backend
__pycache__/
*.pyc
.venv/
.pytest_cache/

# frontend
node_modules/
.next/
*.tsbuildinfo
frontend/next-env.d.ts.bak

# exported guest data
# The CSV export downloads here when triggered from a browser on this
# machine. It contains guest conversation text - personal data that must
# never reach a public repository.
booking-inquiries-*.csv
backups/
# Database dumps, wherever they land. backups/ is already ignored, but a
# pg_dump run from the repo root is not - and a dump is every guest
# transcript in one file.
*.dump
*.sql.gz
*.sql.bz2

# misc
.DS_Store
