# Production environment. Copy to .env.prod ON THE SERVER and fill in.
#
#   cp .env.prod.example .env.prod
#
# .env.prod is gitignored alongside .env. Never commit it: it holds the
# database password, the JWT signing secret and a live provider key.

# --- where it lives ------------------------------------------------------
# The domain whose A record points at this server. Traefik requests a
# certificate for exactly this name, so a typo here means no HTTPS.
DOMAIN=hotel.example.com
# Let's Encrypt sends expiry warnings here. A real mailbox someone reads.
ACME_EMAIL=you@example.com

# --- database ------------------------------------------------------------
POSTGRES_DB=hospitalityos
POSTGRES_USER=hospitalityos
# Generate, do not invent:  openssl rand -base64 32
POSTGRES_PASSWORD=

# --- staff accounts ------------------------------------------------------
# Generate:  docker compose ... run --rm backend python -m app.scripts.seed_admin --print-secret
# Changing this later signs every staff member out. That is the intended
# way to revoke a leaked session, since the JWTs themselves are stateless.
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
# MUST stay true here. False would let the session cookie travel over
# plain HTTP.
COOKIE_SECURE=true
# Empty unless the UI and API are on different subdomains. With the
# Traefik routing in docker-compose.prod.yml they are not.
COOKIE_DOMAIN=

# --- the legacy shared gate ---------------------------------------------
# LEAVE THIS EMPTY. It grants cross-tenant access with no identity and no
# audit trail. Real accounts replaced it; setting it here reopens the
# weaker door. See backend/app/core/auth.py.
STAFF_API_TOKEN=

# --- AI providers --------------------------------------------------------
AI_CHAT_PROVIDER=groq
AI_FAST_PROVIDER=groq
AI_EMBED_PROVIDER=local
AI_CHAT_MODEL=openai/gpt-oss-120b
AI_FAST_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
# If the provider fails (rate limit, outage), answer from retrieved
# passages rather than showing the guest an error. The staff dashboard
# raises a degradation banner when this happens.
AI_CHAT_FALLBACK=extractive
AI_CHAT_RETRIES=2

# --- frontend build-time -------------------------------------------------
# Inlined into the client bundle at BUILD time, so changing it needs a
# rebuild, not just a restart.
NEXT_PUBLIC_WIDGET_HOTEL_ID=1
